APP_ENV=production
SECRET_KEY=
BACKUP_ADMIN_USERNAME=your_username
TIMER_REMINDER_MINUTES=120
DATABASE_URL=sqlite:///./data/app.db
DATA_DIR=/app/data
SESSION_MAX_AGE_DAYS=30
REGISTRATION_ENABLED=false
ENFORCE_SAME_ORIGIN=true
SECURE_COOKIES=true
BACKGROUND_JOBS_ENABLED=true
APP_UID=1000
APP_GID=1000

# Для HTTPS через Caddy + Let's Encrypt.
# Пример для домена REG.RU:
# CADDY_SITE_ADDRESS=example.ru, www.example.ru
CADDY_SITE_ADDRESS=localhost
# ALLOWED_HOSTS=home.example.ru

# Web Push/PWA-уведомления. По умолчанию выключены; private key не коммитить.
HOME_PUSH_ENABLED=false
HOME_PUSH_POLL_SECONDS=60
HOME_PUSH_CATCHUP_MINUTES=60
HOME_VAPID_SUBJECT=mailto:you@example.com
# HOME_VAPID_PUBLIC_KEY=
# HOME_VAPID_PRIVATE_KEY=/app/data/vapid_private.pem
# Дополнительные доверенные домены push-провайдера через запятую (обычно не требуется).
# PUSH_ENDPOINT_HOSTS=push.example.com

# Temporary file sharing. The directory must stay inside DATA_DIR so it uses the persistent volume.
HOME_FILE_SHARE_DIR=/app/data/shared_files
HOME_FILE_SHARE_MAX_FILE_MB=100
HOME_FILE_SHARE_MAX_TRANSFER_MB=500
HOME_FILE_SHARE_CLEANUP_SECONDS=3600
HOME_FILE_SHARE_ORPHAN_GRACE_HOURS=24
# 0 means unlimited. These are safety caps, not billing.
HOME_FILE_SHARE_MAX_STORAGE_MB=0
HOME_FILE_SHARE_MAX_USER_STORAGE_MB=0
HOME_FILE_SHARE_MIN_FREE_MB=512

# Home AI is temporarily frozen. Its code is preserved, but routes and UI stay hidden.
# Set this and AI_ENABLED to true only when resuming Home AI development.
HOME_AI_ENABLED=false
# Home AI uses a separately managed host llama.cpp server when it is resumed.
# Raspberry Pi production setup: docs/home_ai/RASPBERRY_PI_RUNTIME.md
AI_ENABLED=false
# AI_BASE_URL=http://host.docker.internal:8081/v1
# Must match LLAMA_MODEL_ALIAS in /etc/home-ai/llama-server.env.
# AI_MODEL=qwen3.5-4b-q4_k_m
# AI_API_KEY=
AI_CONNECT_TIMEOUT_SECONDS=5
# The 4B model can need more than 60 seconds for cold/complex requests on Pi 5.
AI_READ_TIMEOUT_SECONDS=120
AI_MAX_TOKENS=512
AI_CONTEXT_BUDGET=6000
AI_MAX_CONCURRENCY=1
AI_TEMPERATURE=0.2
AI_ENABLE_THINKING=false

# Optional: override package index for Docker builds if the server has trouble reaching PyPI.
# PIP_INDEX_URL=https://pypi.org/simple
# PIP_EXTRA_INDEX_URL=
