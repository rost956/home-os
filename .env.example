APP_ENV=production
SECRET_KEY=
BACKUP_ADMIN_USERNAME=your_username
TIMER_REMINDER_MINUTES=120
DATABASE_URL=sqlite:///./data/app.db
DATA_DIR=/app/data
SESSION_MAX_AGE_DAYS=30
REGISTRATION_ENABLED=false
ENFORCE_SAME_ORIGIN=true
SECURE_COOKIES=true
BACKGROUND_JOBS_ENABLED=true
APP_UID=1000
APP_GID=1000

# Для HTTPS через Caddy + Let's Encrypt.
# Пример для домена REG.RU:
# CADDY_SITE_ADDRESS=example.ru, www.example.ru
CADDY_SITE_ADDRESS=localhost
# ALLOWED_HOSTS=home.example.ru

# Web Push/PWA-уведомления. Можно не заполнять: сервис сам создаст ключи в data/push_vapid.json.
VAPID_SUBJECT=mailto:you@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Дополнительные доверенные домены push-провайдера через запятую (обычно не требуется).
# PUSH_ENDPOINT_HOSTS=push.example.com

# Optional: override package index for Docker builds if the server has trouble reaching PyPI.
# PIP_INDEX_URL=https://pypi.org/simple
# PIP_EXTRA_INDEX_URL=
