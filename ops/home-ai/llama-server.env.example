# Installed as /etc/home-ai/llama-server.env (mode 0640, root:home-ai).
# Values must not contain shell expressions. The systemd unit expands them as
# individual arguments and does not invoke a shell.

LLAMA_SERVER_BIN=/opt/home-ai/llama.cpp/build/bin/llama-server
LLAMA_WORKING_DIRECTORY=/opt/home-ai/llama.cpp
LLAMA_MODEL_PATH=/opt/home-ai/models/Qwen3.5-4B-Q4_K_M.gguf
LLAMA_MODEL_ALIAS=qwen3.5-4b-q4_k_m

# Bind only to the host address used by Docker's host-gateway mapping. Confirm
# the address on the Pi as documented in RASPBERRY_PI_RUNTIME.md. Never use
# 0.0.0.0 here.
LLAMA_HOST=172.17.0.1
LLAMA_PORT=8081
LLAMA_STARTUP_TIMEOUT_SECONDS=540

# Conservative Raspberry Pi 5 8 GB defaults. Increase only after measuring.
LLAMA_THREADS=4
LLAMA_THREADS_BATCH=4
LLAMA_CTX_SIZE=4096
LLAMA_BATCH_SIZE=256
LLAMA_UBATCH_SIZE=128
LLAMA_PARALLEL=1
LLAMA_N_PREDICT=512

# One random key per line, mode 0640, root:home-ai. /health remains unauthenticated
# in llama.cpp, while /v1 endpoints require this key.
LLAMA_API_KEY_FILE=/etc/home-ai/llama-api-key
